# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local game database (use the app's Export button for backups)
prisma/*.db
prisma/*.db-journal

# Prisma installs vendor skill docs for AI editors on `prisma init`.
# Regenerable from skills-lock.json, so keep them out of the repo.
/.agents/
/.claude/
/.windsurf/
!.env.example
